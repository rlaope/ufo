{
  "name": "ufo-agents",
  "version": "0.1.0",
  "description": "Make anything faster with agents, from p99 latency down to tokens per second.",
  "license": "MIT",
  "author": "rlaope",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rlaope/ufo.git"
  },
  "homepage": "https://github.com/rlaope/ufo#readme",
  "bugs": {
    "url": "https://github.com/rlaope/ufo/issues"
  },
  "keywords": [
    "optimization",
    "performance",
    "benchmark",
    "agents",
    "mcp"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ufo": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "src/techniques/**/*.yaml",
    "src/presets/*.cjs",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "audit:deps": "npm audit --omit=dev && node scripts/audit-bundled.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "picomatch": "4.0.7",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
